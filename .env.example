# ==============================================================================
# eScholar Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` (or `.env.local`) in the root or `Front-End` directory
# and populate with valid credentials before starting the development server.

# ------------------------------------------------------------------------------
# NIDAS / eVerify Face Liveness SDK (Philippine National ID / eGov eKYC)
# ------------------------------------------------------------------------------
VITE_NIDAS_BASE_URL=https://hackathon-everify-face-liveness.e.gov.ph
VITE_NIDAS_CLIENT_ID=your_nidas_client_id_here
VITE_NIDAS_CLIENT_SECRET=your_nidas_client_secret_here
VITE_NIDAS_PUB_KEY=your_nidas_public_key_here

# ------------------------------------------------------------------------------
# eGov PH eMessage SMS Service (2-Factor Authentication OTPs)
# ------------------------------------------------------------------------------
VITE_EMESSAGE_AUTH=your_egov_emessage_auth_token_here

# ------------------------------------------------------------------------------
# AI Document Extractor / OCR Engine (Transcripts & Grades Parser)
# ------------------------------------------------------------------------------
VITE_AI_BASE_URL=https://platforms-api.e.gov.ph
VITE_AI_API_TOKEN=your_ai_extractor_api_token_here
